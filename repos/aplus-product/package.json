    "@types/bcryptjs": "2.4.6",
    "@types/pg": "8.16.0",
    "ai": "^6.0.208",
    "argon2": "0.44.0",
    "aws-s3-form": "0.3.5",
    "bcryptjs": "3.0.3",
    "better-auth": "1.6.23",
    "client-only": "0.0.1",
    "date-fns": "4.1.0",
    "dayjs": "1.11.19",
    "file-type": "21.3.0",
    "html-to-image": "^1.11.13",
    "ioredis": "5.10.0",
    "isomorphic-dompurify": "3.0.0",
    "jose": "6.1.3",
    "lightningcss": "1.30.2",
    "lottie-react": "2.4.1",
    "motion": "12.34.3",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "postcss": "8.5.6",
    "prisma": "7.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.68.0",
    "react-qr-code": "2.0.18",
    "react-window": "^1.8.11",
    "server-only": "0.0.1",
    "sharp": "0.33.5",
    "superjson": "2.2.6",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "xlsx": "0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@jest/test-sequencer": "29.7.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/argon2": "0.14.1",
    "@types/dompurify": "3.2.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.27",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-window": "1.8.8",
    "eslint": "9.39.2",
    "eslint-config-next": "15.2.4",
    "husky": "9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-transform-stub": "2.0.0",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "sass": "1.97.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.5",
    "handlebars": "^4.7.9"
  },
  "engines": {
    "node": "22.12.0"
  },
  "packageManager": "bun@1.1.36"
