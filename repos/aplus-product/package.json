{
  "name": "administration-plus",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prebuild": "tsx scripts/validate-env.ts && react-dsfr update-icons",
    "env:validate": "tsx scripts/validate-env.ts",
    "env:list": "tsx scripts/validate-env.ts --list",
    "email:check": "tsx scripts/check-email-templates.ts",
    "dev": "sh scripts/dev.sh",
    "build": "react-dsfr update-icons && npm rebuild lightningcss && prisma generate && prisma migrate deploy && next build && node copy-assets.js",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint src",
    "check": "tsc --noEmit",
    "test": "jest --maxWorkers=75%",
    "test:ci": "jest --maxWorkers=50% --ci --coverage",
    "test:watch": "jest --watch --maxWorkers=50%",
    "test:changed": "jest --onlyChanged",
    "format": "prettier --write . --ignore-unknown",
    "init-db": "tsx --env-file=.env prisma/script/init-production-db.ts",
    "init-db:staging": "tsx --env-file=.env prisma/script/init-production-db.ts --staging",
    "pipeline:batch": "tsx --env-file=.env prisma/script/pipeline-batch.ts",
    "golden-dataset:seed": "tsx --env-file=.env prisma/script/golden-dataset-seed.ts",
    "golden-dataset:predict": "tsx --env-file=.env prisma/script/golden-dataset-predict.ts",
    "postinstall": "(npm rebuild sharp lightningcss 2>/dev/null || bun pm rebuild sharp lightningcss 2>/dev/null || true)",
    "db:sync-staging": "bash scripts/db/sync-to-staging.sh",
    "db:sync-production": "bash scripts/db/sync-to-production.sh",
    "prepare": "husky",
    "k6:smoke": "k6 run load-tests/scenarios/healthcheck.js",
    "k6:auth": "k6 run load-tests/scenarios/auth.js",
    "k6:queries": "k6 run load-tests/scenarios/trpc-queries.js",
    "k6:mutations": "k6 run load-tests/scenarios/trpc-mutations.js",
    "k6:journey": "k6 run load-tests/scenarios/user-journey.js",
    "k6:all": "k6 run load-tests/scenarios/healthcheck.js && k6 run load-tests/scenarios/auth.js && k6 run load-tests/scenarios/trpc-queries.js && k6 run load-tests/scenarios/user-journey.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@aws-sdk/client-s3": "3.955.0",
    "@better-auth/redis-storage": "1.6.23",
    "@codegouvfr/react-dsfr": "1.30.3",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@faker-js/faker": "9.9.0",
    "@getbrevo/brevo": "3.0.1",
    "@gouvfr/dsfr-chart": "^2.1.1",
    "@hookform/devtools": "4.4.0",
    "@hookform/resolvers": "5.2.2",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@mui/material-nextjs": "7.3.6",
    "@mui/system": "5.18.0",
    "@mui/x-date-pickers": "5.0.20",
    "@prisma/adapter-pg": "7.1.0",
    "@prisma/client": "7.1.0",
    "@prisma/engines": "7.1.0",
    "@sentry/nextjs": "10.32.1",
    "@socialgouv/matomo-next": "1.13.1",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/react-query": "5.90.12",
    "@tanstack/react-table": "8.21.3",
    "@trpc/client": "11.8.0",
